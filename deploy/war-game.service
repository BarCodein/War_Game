[Unit]
Description=War of Dots · PvP server (Node 22, listens 127.0.0.1:3001)
Documentation=https://github.com/BarCodein/War_Game/blob/main/docs/pvp-deploy.md
After=network.target

[Service]
Type=simple
# 建议单独建一个系统用户：sudo useradd --system --home /opt/war-game-server --shell /usr/sbin/nologin wargame
User=wargame
Group=wargame
WorkingDirectory=/opt/war-game-server
Environment=NODE_ENV=production
# 1 核 / 2 GB：给 V8 留出上限，避免和 Nginx 抢内存
Environment=NODE_OPTIONS=--max-old-space-size=768
Environment=PVP_PORT=3001
Environment=PVP_MAX_ROOMS=4
Environment=PVP_SNAPSHOT_HZ=15
ExecStart=/usr/bin/node server/src/index.js
Restart=always
RestartSec=3

# 兜底：进程内存硬上限（超过会被 systemd 杀掉并按 Restart=always 重启）
MemoryMax=1G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
# SQLite 数据目录 → /var/lib/war-game（git pull 不会碰它，权限由 systemd 管）
StateDirectory=war-game

[Install]
WantedBy=multi-user.target
