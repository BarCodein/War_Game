  "ai": [
    {
      "faction": "red",
      "preset": "cautious",
      "triggers": [
        {
          "id": "defend_three_cities",
          "at": { "time": 0 },
          "actions": [
            { "type": "hold", "units": { "group": "zhangjiakouGuard" } },
            { "type": "hold", "units": { "group": "beipingGuard" } },
            { "type": "hold", "units": { "group": "beipingReserve" } },
            { "type": "hold", "units": { "group": "tianjinGuard" } }
          ]
        },
        {
          "id": "beiping_reserve_marches_to_zhangjiakou",
          "at": { "time": 45 },
          "actions": [
            { "type": "engage", "target": { "anchor": "zhangjiakou" }, "units": { "group": "beipingReserve" } }
          ]
        }
      ],
      "rules": [
        {
          "id": "zhangjiakou_lost",
          "when": { "city": "c18", "owner": "enemy" },
          "repeatEvery": 30,
          "then": [
            { "type": "engage", "target": { "anchor": "zhangjiakou" }, "units": { "group": "beipingReserve" } },
            { "type": "engage", "target": { "anchor": "zhangjiakou" }, "units": { "group": "zhangjiakouGuard" } }
          ]
        },
        {
          "id": "beiping_gate_lost",
          "when": { "capturePoint": "p8", "owner": "enemy" },
          "then": [
            { "type": "engage", "target": { "anchor": "beiping" }, "units": { "group": "beipingGuard" } }
          ]
        },
        {
          "id": "tianjin_gate_lost",
          "when": { "capturePoint": "p11", "owner": "enemy" },
          "repeatEvery": 25,
          "then": [
            { "type": "engage", "target": { "anchor": "tianjin" }, "units": { "group": "tianjinGuard" } }
          ]
        },
        {
          "id": "consolidate_when_weak",
          "when": { "ownUnitsBelow": 10 },
          "then": [
            { "type": "engage", "target": { "anchor": "beiping" } }
          ]
        }
      ]
    },
    {
      "faction": "blue",
      "preset": "standard",
      "triggers": [
        {
          "id": "northeast_reinforcement",
          "at": { "time": 40 },
