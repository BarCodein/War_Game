              "unitType": "heavy",
              "count": 3,
              "at": { "x": 1100, "y": 444 },
              "group": "relief",
              "spacing": { "x": 34, "y": 0 },
              "order": { "type": "attackMove", "target": { "anchor": "tianjin" } }
            }
          ]
        }
      ]
