{
  "version": 1,
  "id": "shuangduiji_battle",
  "name": "双堆集战役",
  "subtitle": "SHUANGDUIJI BATTLE",
  "type": "annihilative",
  "difficulty": "教学",
  "description": "阻止黄维兵团北进增援徐州战场，将其歼灭在双堆集",
  "map": "/assets/maps/shuangduiji.json",

  "anchors": {
    "northRiver": { "spawnId": "s3" },
    "shuangduiji": { "cityId": "c7"},
    "nanpingji": { "spawnId": "s2"},
    "westNorth": { "spawnId": "s4"},
    "eastSouth": { "spawnId": "s1"},
    "redDeploy": { "spawnId": "s5"}
  },

  "forces": [
    {
      "faction": "blue",
      "at": { "spawnId": "s2" },
      "units": [
        { "type": "light", "spacing": { "x": 30, "y": 0 },"count": 3 },
        { "type": "heavy", "spacing": { "x": 30, "y": 0 },"offset": { "x": 0, "y": 42 },"count": 2 }
      ]
    },
    {
      "faction": "blue",
      "at": { "spawnId": "s3" },
      "units": [
        { "type": "light","spacing": { "x": 30, "y": 0 }, "count": 4 }
      ]
    },
    {
      "faction": "blue",
      "at": { "spawnId": "s4" },
      
      "units": [
        { "type": "light", "spacing": { "x": 10, "y": -10 },"count": 6 }
      ]
    },

    {
      "faction": "red",
      "objective": "annihilate",
      "group": "vanguard1",
      "at": { "anchor": "redDeploy" },
      "units": [
        { "type": "light", "count": 6 }
      ]
    },
    {
      "faction": "red",
      "objective": "annihilate",
      "group": "vanguard2",
      "at": { "anchor": "redDeploy" },
      "units": [
        { "type": "light", "count": 6 }
      ]
    },
    {
      "faction": "red",
      "objective": "annihilate",
      "group": "sortie",
      "at": { "anchor": "redDeploy" },
      "units": [
        { "type": "light", "count": 3 }
      ]
    },
    {
      "faction": "red",
      "objective": "annihilate",
      "group": "main",
      "at": { "anchor": "redDeploy" },
      "units": [
        { "type": "heavy", "count": 2 },
        { "type": "light", "count": 4 }
      ]
    }
  ],

  "ai": [
  {
    "faction": "red",
    "preset": "standard",
    "fallback": { "anchor": "shuangduiji" },
    "triggers": [
      {
        "id": "phase1_vanguard_to_nanpingji",
        "at": { "time": 2 },
        "actions": [
          { "type": "engage", "target": { "anchor": "nanpingji" }, "units": { "group": "vanguard1" } }
        ]
      },
      {
        "id": "phase2_vanguard_to_northbank",
        "at": { "time": 5 },
        "actions": [
          { "type": "engage", "target": { "capturePointId": "p6" }, "units": { "group": "vanguard2" } }
        ]
      },
      {
        "id": "phase3_main_to_shuangduiji",
        "at": { "time": 30 },
        "actions": [
          { "type": "engage", "target": { "anchor": "shuangduiji" }, "units": { "group": "main" } }
        ]
      },
      {
        "id": "phase4_sortie_southeast",
        "at": { "time": 50 },
        "actions": [
          { "type": "engage", "target": { "anchor": "eastSouth" }, "units": { "group": "sortie" } }
        ]
      },
      {
        "id": "phase5_regroup",
        "at": { "time": 180 },
        "actions": [
          { "type": "engage", "target": { "anchor": "shuangduiji" } }
        ]
      }
    ],

    "rules": [
      {
        "id": "vanguard1_hold_or_withdraw",
        "after": 60,
        "when": { "capturePoint": "p7", "owner": "self" },
        "then": [{ "type": "hold", "units": { "group": "vanguard1" } }],
        "otherwise": [{ "type": "retreat", "to": { "anchor": "shuangduiji" }, "units": { "group": "vanguard1" } }]
      },
      {
        "id": "vanguard2_hold_or_withdraw",
        "after": 100,
        "when": { "capturePoint": "p6", "owner": "self" },
        "then": [{ "type": "hold", "units": { "group": "vanguard2" } }],
        "otherwise": [{ "type": "retreat", "to": { "anchor": "shuangduiji" }, "units": { "group": "vanguard2" } }]
      },
      {
        "id": "main_press",
        "when": { "time": 30 },
        "until": 180,
        "repeatEvery": 20,
        "then": [{ "type": "engage", "target": { "anchor": "shuangduiji" }, "units": { "group": "main" } }]
      },
      {
        "id": "sortie_press",
        "when": { "time": 140 },
        "until": 180,
        "repeatEvery": 20,
        "then": [{ "type": "engage", "target": { "anchor": "eastSouth" }, "units": { "group": "sortie" } }]
      },
      {
        "id": "hold_shuangduiji",
        "after": 220,
        "when": { "city": "c7", "owner": "self" },
        "then": [
          { "type": "hold", "units": { "group": "main" } },
          { "type": "hold", "units": { "group": "vanguard1" } },
          { "type": "hold", "units": { "group": "vanguard2" } },
          { "type": "hold", "units": { "group": "sortie" } }
        ],
        "otherwise": [{ "type": "engage", "target": { "anchor": "shuangduiji" } }]
      }
    ]
  },

  {
    "faction": "blue",
    "preset": "standard",
    "triggers": [
      {
        "id": "huayeRelief1",
        "at": { "time": 90 },
        "actions": [
          {
            "type": "spawn",
            "unitType": "light",
            "count": 3,
            "at": { "anchor": "eastSouth" },
            "group": "relief",
            "spacing": { "x": 0, "y": 24 },
            "order": { "type": "attackMove", "target": { "anchor": "shuangduiji" } }
          }
        ]
      },
      {
        "id": "huayeRelief2",
        "at": { "time": 150 },
        "actions": [
          {
            "type": "spawn",
            "unitType": "light",
            "count": 2,
            "at": { "anchor": "eastSouth" },
            "group": "relief",
            "spacing": { "x": 0, "y": 24 },
            "order": { "type": "attackMove", "target": { "anchor": "shuangduiji" } }
          },
          {
            "type": "spawn",
            "unitType": "heavy",
            "count": 1,
            "at": { "anchor": "eastSouth" },
            "group": "relief",
            "spacing": { "x": 0, "y": 24 },
            "order": { "type": "attackMove", "target": { "anchor": "shuangduiji" } }
          }
        ]
      }
    ]
  }
  ],

  "victory": { "mode": "annihilative", "faction": "blue" }
}
